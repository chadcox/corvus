{
  "name": "corvus-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:mocked": "playwright test e2e/smoke.spec.ts e2e/analyst-flows.spec.ts e2e/control-panel.spec.ts --reporter=line",
    "screenshots": "playwright test screenshots.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ci": "PLAYWRIGHT_USE_WEBSERVER=0 PLAYWRIGHT_BASE_URL=http://web:5173 npm run test:e2e:mocked",
    "test:e2e:backend": "PLAYWRIGHT_USE_WEBSERVER=0 PLAYWRIGHT_BASE_URL=http://web:5173 PLAYWRIGHT_BACKEND_E2E=1 playwright test e2e/backend-analyst-flow.spec.ts --reporter=line"
  },
  "dependencies": {
    "@fontsource/libre-franklin": "^5.3.0",
    "@fontsource/red-hat-mono": "^5.3.0",
    "@fontsource/syne": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.10",
    "react": "^19.0.0",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "~6.0.3",
    "vite": "^8.2.2"
  }
}
